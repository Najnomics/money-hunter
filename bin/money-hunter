#!/usr/bin/env bash
# Stable launcher for Money Hunter.
#
# Examples:
#   ./bin/money-hunter --list
#   ./bin/money-hunter 0 parse_scope --workspace /target --repos .
#   ./bin/money-hunter --mcp
#
# The launcher prefers the project virtualenv, then falls back to python3.
set -euo pipefail

CORE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -x "$CORE/.venv/bin/python" ]; then
  PY="$CORE/.venv/bin/python"
elif [ -x "$CORE/.venv/Scripts/python.exe" ]; then
  PY="$CORE/.venv/Scripts/python.exe"
else
  PY="$(command -v python3 || command -v python)"
fi

exec "$PY" "$CORE/main.py" "$@"
